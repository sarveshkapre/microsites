{
  "name": "microsites",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w gallery",
    "build": "npm run build -w gallery",
    "start": "npm run start -w gallery",
    "lint": "npm run lint -w gallery",
    "lint:all": "npm run lint --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "verify": "npm run lint:all && npm run build:pages && npm run check:bundles && npm run check:a11y && npm run check:deploy-urls",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:gallery": "npm run dev -w gallery",
    "build:gallery": "npm run build -w gallery",
    "lint:gallery": "npm run lint -w gallery",
    "dev:premium-product": "npm run dev -w premium-product",
    "build:premium-product": "npm run build -w premium-product",
    "lint:premium-product": "npm run lint -w premium-product",
    "dev:editorial-scrolly": "npm run dev -w editorial-scrolly",
    "build:editorial-scrolly": "npm run build -w editorial-scrolly",
    "lint:editorial-scrolly": "npm run lint -w editorial-scrolly",
    "dev:neon-cinematic": "npm run dev -w neon-cinematic",
    "build:neon-cinematic": "npm run build -w neon-cinematic",
    "lint:neon-cinematic": "npm run lint -w neon-cinematic",
    "dev:playful-micro": "npm run dev -w playful-micro",
    "build:playful-micro": "npm run build -w playful-micro",
    "lint:playful-micro": "npm run lint -w playful-micro",
    "dev:webgl-dom-sync": "npm run dev -w webgl-dom-sync",
    "build:webgl-dom-sync": "npm run build -w webgl-dom-sync",
    "lint:webgl-dom-sync": "npm run lint -w webgl-dom-sync",
    "dev:dataviz-scrolly": "npm run dev -w dataviz-scrolly",
    "build:dataviz-scrolly": "npm run build -w dataviz-scrolly",
    "lint:dataviz-scrolly": "npm run lint -w dataviz-scrolly",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "check:a11y": "node scripts/check-a11y-bar.mjs",
    "check:deploy-urls": "node scripts/check-deploy-urls.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ci": "node scripts/smoke.mjs --app gallery --port 3100 --timeout-ms 30000 && node scripts/smoke.mjs --app premium-product --port 3101 --timeout-ms 30000 && node scripts/smoke.mjs --app editorial-scrolly --port 3102 --timeout-ms 30000 && node scripts/smoke.mjs --app neon-cinematic --port 5201 --timeout-ms 30000"
  }
}
